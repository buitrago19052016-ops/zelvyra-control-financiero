name: Construir ZELVYRA Android

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Descargar proyecto
        uses: actions/checkout@v4

      - name: Descomprimir ZELVYRA
        run: |
          mkdir -p source
          unzip -q ZELVYRA-Control-Financiero-TERMINAD.zip -d source

      - name: Preparar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - name: Preparar Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: npm
          cache-dependency-path: source/zelvyra-control-financiero-app/package.json

      - name: Instalar Android SDK
        uses: android-actions/setup-android@v3

      - name: Instalar dependencias
        working-directory: source/zelvyra-control-financiero-app
        run: |
          npm install
          npm install @capacitor/android@^7.4.3

      - name: Crear proyecto Android
        working-directory: source/zelvyra-control-financiero-app
        run: |
          npx cap add android

      - name: Sincronizar Android
        working-directory: source/zelvyra-control-financiero-app
        run: |
          npm run build
          npx cap sync android

      - name: Generar APK
        working-directory: source/zelvyra-control-financiero-app/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Guardar APK
        uses: actions/upload-artifact@v4
        with:
          name: ZELVYRA-Android-APK
          path: source/zelvyra-control-financiero-app/android/app/build/outputs/apk/debug/app-debug.apk
